{
 "file_spec": 1.1,
 "file_creator": "OrigamiSimulator computation tools (computation/generate_gadgets.mjs)",
 "file_title": "2-bit adder (Hull–Zakharevich gadgets)",
 "file_description": "2-bit ripple-carry adder: (A1..A0) + (B1..B0) + Cin = (Cout S1..S0), made of one-bit full adders whose Cout feeds the next Cin through a straight pleat. A honeycomb of triangle twists from Hull & Zakharevich (arXiv:2309.07932), where some twists carry the control folds of the paper's NOR, NAND, OR and AND gates. Layout found by computation/honeycomb_search.py.",
 "frame_classes": [
  "creasePattern"
 ],
 "frame_unit": "unit",
